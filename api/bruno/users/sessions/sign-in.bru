meta {
  name: Sign In
  type: http
  seq: 1
}

post {
  url: {{base_url}}/users/sign_in
  body: json
  auth: none
}

body:json {
  {
    "user": {
      "email": "user@example.com",
      "password": "password"
    }
  }
}

script:post-response {
  const authHeader = res.headers['authorization'];
  if (authHeader) {
    bru.setVar('token', authHeader.replace('Bearer ', ''));
  }
}
