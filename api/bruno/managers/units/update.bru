  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "unit": {
      "name": "Loja Centro",
      "cep": "90010000",
      "street": "Rua dos Andradas",
      "street_number": "100"
    }
  }
}
